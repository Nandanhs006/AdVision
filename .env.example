# SceneCast Commercial Intent & RTB Engine
INTENT_ENGINE_MODE=simulated
GOOGLE_ADSENSE_PUBLISHER_ID=pub-9482-1048-2847
GOOGLE_ADSENSE_API_KEY=
META_GRAPH_API_VERSION=v21.0

# LLM Orchestration (Groq or any OpenAI-compatible provider)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional Caching (Upstash Redis) - Falls back to in-memory LRU if unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# Part 2: Ad Studio & Meta Integration
# ==========================================

# Secret Key for AES-256-GCM encryption of stored Meta tokens at rest (32 bytes)
TOKEN_ENCRYPTION_KEY=advision_production_encryption_key_32_bytes!

# Meta Integration Mode: 'simulated' (default for demo/hackathon) or 'live'
META_MODE=simulated

# Meta Graph API v21.0 OAuth credentials (required only when META_MODE=live)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback

