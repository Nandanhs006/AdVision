# ==========================================
# AdVision — Meta AI & Meta Ads Configuration
# Meta Global AI Developer Hackathon
# ==========================================

# Commercial Intent & Audience Network Engine mode: 'simulated' or 'live'
INTENT_ENGINE_MODE=simulated

# Meta Model API ($150 Credit Access)
# Supports Muse Spark (text/reasoning), Muse Wonder (video/multimodal), Muse Image (creative backdrops), SAM 3.1 (segmentation)
META_MODEL_API_KEY=
META_MODEL_API_BASE=https://api.meta.com/v1
META_TEXT_MODEL=muse-spark
META_VISION_MODEL=muse-wonder
META_IMAGE_MODEL=muse-image
META_SEGMENTATION_MODEL=sam-3.1

# Open-Weight Fallback via Baseten / Modal (Hackathon Model ID: meta-models/muse-spark-open-1026)
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# AI Provider Routing: 'meta' | 'baseten' | 'simulated'
AI_PROVIDER_MODE=meta

# Optional Legacy / OpenAI-compatible fallback provider
LLM_BASE_URL=
LLM_MODEL=

# Meta Ads Manager & Audience Network Integration
META_GRAPH_API_VERSION=v21.0
META_AUDIENCE_NETWORK_PLACEMENT_ID=in_scene_billboard_shibuya_01
META_MODE=simulated
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback

# Secret Key for AES-256-GCM encryption of stored Meta tokens at rest (32 bytes)
TOKEN_ENCRYPTION_KEY=advision_production_encryption_key_32_bytes!

# Optional Caching (Upstash Redis) - Falls back to in-memory LRU if unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
