# ==========================================
# AdVision — Meta AI & Meta Ads Configuration
# Meta Global AI Developer Hackathon
# ==========================================

# Commercial Intent & Audience Network Engine mode: 'simulated' or 'live'
INTENT_ENGINE_MODE=simulated

# AI Provider Routing: 'meta' | 'fireworks' | 'baseten' | 'simulated'
# When set to 'meta', it automatically fails over to Fireworks if rate-limited or unavailable.
AI_PROVIDER_MODE=meta

# Primary: Meta Model API ($150 Credit Access)
# Supports Llama 3.3 70B, Llama 3.2 Vision, Muse Spark, Muse Wonder, SAM 3.1
META_MODEL_API_KEY=
META_MODEL_API_BASE=https://api.meta.com/v1
META_TEXT_MODEL=llama-3.3-70b-instruct
META_VISION_MODEL=llama-3.2-11b-vision-instruct
META_IMAGE_MODEL=muse-image
META_SEGMENTATION_MODEL=sam-3.1

# Automatic Backup Partner: Fireworks AI ($100 Credit Access)
# Meta Llama 3.2 11B Vision & Meta Llama 3.3 70B Instruct
FIREWORKS_API_KEY=
FIREWORKS_API_BASE=https://api.fireworks.ai/inference/v1
FIREWORKS_VISION_MODEL=accounts/fireworks/models/llama-v3p2-11b-vision-instruct
FIREWORKS_TEXT_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Alternative Open-Weight Fallback via Baseten / Modal
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Optional Legacy / OpenAI-compatible fallback provider
LLM_BASE_URL=
LLM_MODEL=

# Meta Ads Manager & Audience Network Integration
META_GRAPH_API_VERSION=v21.0
META_AUDIENCE_NETWORK_PLACEMENT_ID=in_scene_billboard_shibuya_01
META_MODE=simulated
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback

# Secret Key for AES-256-GCM encryption of stored Meta tokens at rest (32 bytes)
TOKEN_ENCRYPTION_KEY=advision_production_encryption_key_32_bytes!

# Optional Caching (Upstash Redis) - Falls back to in-memory LRU if unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
